---
import '../styles/global.css'
import Diagram from '../components/Diagram.astro'
import { profile, projects, publications, roles } from '../data/portfolio'

/** Split on backticks so `code` in the data renders as <code> without a markdown dependency. */
function segments(text: string): { code: boolean; text: string }[] {
  return text.split('`').map((part, i) => ({ code: i % 2 === 1, text: part }))
}

const title = `${profile.name} — software, machine learning, infrastructure`
const description =
  'M.S. Computer Science at Indiana University. MCP conformance tooling in Go, agent evaluation in Python, serverless AWS, and three peer-reviewed papers.'
const og = new URL('/og.png', Astro.site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site?.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={profile.name} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body>
    <a class="skip" href="#work">Skip to the work</a>

    <div class="wrap">
      <header>
        <picture>
          <source media="(prefers-color-scheme: dark)" srcset="/terminal-dark.svg" />
          <source media="(prefers-color-scheme: light)" srcset="/terminal-light.svg" />
          <img
            class="panel"
            src="/terminal-light.svg"
            alt={`Terminal panel introducing ${profile.name}: M.S. Computer Science at Indiana University, SDE intern at SparkFX, three peer-reviewed papers, based in Bloomington, Indiana.`}
            width="980"
            height="759"
          />
        </picture>

        <h1>{profile.name}</h1>
        <p class="tagline">{profile.tagline}</p>
        <p class="blurb">{profile.blurb}</p>
        <ul class="links">
          {profile.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </header>

      <main>
        <section id="work">
          <h2>Selected work</h2>
          {projects.map((p) => (
            <article class="project">
              <div class="project-head">
                <h3><a href={p.repo}>{p.name}</a></h3>
                <span class="project-tag">{p.tagline}</span>
              </div>

              {p.body.map((para) => (
                <p>{segments(para).map((s) => (s.code ? <code>{s.text}</code> : <Fragment>{s.text}</Fragment>))}</p>
              ))}

              {p.diagram && <Diagram kind={p.diagram} />}

              {p.facts && (
                <ul class="facts">
                  {p.facts.map((f) => <li>{f}</li>)}
                </ul>
              )}

              {p.caveat && (
                <p class="caveat"><strong>Stated plainly:</strong> {p.caveat}</p>
              )}

              <ul class="stack">
                {p.stack.map((s) => <li>{s}</li>)}
              </ul>
            </article>
          ))}
        </section>

        <section id="research">
          <h2>Peer-reviewed research</h2>
          <div class="rows">
            {publications.map((pub) => (
              <div class="row">
                <div class="row-side">{pub.venue}</div>
                <div class="row-main">
                  <h3>{pub.title}</h3>
                  <p>{pub.method}</p>
                  {pub.repo && <p><a href={pub.repo}>Code</a> · <span class="pending">DOI pending</span></p>}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section id="experience">
          <h2>Experience</h2>
          <div class="rows">
            {roles.map((r) => (
              <div class="row">
                <div class="row-side">{r.period}</div>
                <div class="row-main">
                  <h3>{r.title} · {r.org}</h3>
                  <ul>{r.points.map((pt) => <li>{pt}</li>)}</ul>
                </div>
              </div>
            ))}
          </div>
        </section>
      </main>

      <footer>
        <p>
          {profile.location} · <a href={`mailto:${profile.email}`}>{profile.email}</a> ·
          <a href="https://github.com/patsypppe"> GitHub</a> ·
          <a href="https://www.linkedin.com/in/pranavpattanashetty"> LinkedIn</a>
        </p>
        <p>
          Built with Astro and TypeScript. <a href="https://github.com/patsypppe/patsypppe.github.io">Source</a>.
          Every figure here is traceable to a public repository; anything that is not reproducible from the code says so.
        </p>
      </footer>
    </div>
  </body>
</html>
