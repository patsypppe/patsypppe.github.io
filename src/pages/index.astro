---
import '../styles/global.css'
import Diagram from '../components/Diagram.astro'
import Measure from '../components/Measure.astro'
import Shot from '../components/Shot.astro'
import { profile, index, products, tools, publications, roles, schools } from '../data/portfolio'

const title = `${profile.name}, software engineer`
const description =
  'Software engineer finishing an M.S. in Computer Science at Indiana University, May 2027. Creuno, a creator sponsorship marketplace in beta; AIGO, serverless ride-hailing on AWS; open-source tools for AI agents; three peer-reviewed papers.'
const og = new URL('/og.png', Astro.site).href

const HERO_SIZES = '(min-width: 1240px) 1184px, calc(100vw - 40px)'
const GRID_SIZES = '(min-width: 1240px) 584px, (min-width: 760px) calc(50vw - 36px), calc(100vw - 40px)'

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Software Engineer',
  url: Astro.site?.href,
  email: `mailto:${profile.email}`,
  alumniOf: schools.map((s) => ({ '@type': 'CollegeOrUniversity', name: s.name })),
  sameAs: ['https://github.com/patsypppe', 'https://www.linkedin.com/in/pranavpattanashetty'],
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f3f5f2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site?.href} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={profile.name} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/schibsted-grotesk-wght.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>

  <body>
    <a class="skip" href="#work">Skip to the work</a>

    <header class="masthead wrap">
      <nav class="topnav" aria-label="Sections">
        <a href="#work">Products</a>
        <a href="#open-source">Open source</a>
        <a href="#research">Research</a>
        <a href="#experience">Experience</a>
        <a class="topnav-mail" href={`mailto:${profile.email}`}>Email me</a>
      </nav>

      <h1>{profile.name}</h1>
      <div class="intro">
        <div class="intro-main">
          <p class="headline">{profile.headline}</p>
          <p class="lede">{profile.lede}</p>
          <p class="looking"><span class="dot" aria-hidden="true"></span>{profile.looking}</p>
          <ul class="links" aria-label="Contact">
            {profile.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>

        <nav class="index" aria-label="Work on this page, with its headline result">
          <ol>
            {index.map((e) => (
              <li>
                <a href={e.href}>
                  <span class="index-name">{e.name}</span>
                  <span class="index-result">{e.result}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </header>

    <main>
      <section id="work" class="section wrap" aria-labelledby="work-h">
        <h2 id="work-h" class="section-title">Products</h2>

        {products.map((p, i) => (
          <article class="project" id={p.id} aria-labelledby={`${p.id}-h`}>
            <header class="project-head">
              <h3 id={`${p.id}-h`}>{p.name}</h3>
              {p.status && <p class="status">{p.status}</p>}
              <p class="summary">{p.summary}</p>
              <p class="project-links">{p.links.map((l) => <a href={l.href}>{l.label}</a>)}</p>
            </header>

            <Shot shot={p.hero} sizes={HERO_SIZES} eager={i === 0} class="shot-hero" />

            <div class:list={['project-body', { 'has-measures': p.measures.length > 0 }]}>
              <div class="prose">
                {p.body.map((para) => <p>{para}</p>)}
                <p class="stack">Built with {p.stack.join(', ')}.</p>
              </div>
              {p.measures.length > 0 && (
                <div class="measures">
                  {p.measures.map((m) => <Measure measure={m} />)}
                </div>
              )}
            </div>

            <div class:list={['gallery', { 'gallery-2': p.gallery.length % 2 === 0 }]}>
              {p.gallery.map((s) => <Shot shot={s} sizes={GRID_SIZES} />)}
            </div>
          </article>
        ))}
      </section>

      <section id="open-source" class="section wrap" aria-labelledby="oss-h">
        <h2 id="oss-h" class="section-title">Open source</h2>

        {tools.map((t) => (
          <article class="project tool" id={t.id} aria-labelledby={`${t.id}-h`}>
            <header class="project-head">
              <h3 id={`${t.id}-h`}>{t.name}</h3>
              <p class="summary">{t.summary}</p>
              <p class="project-links"><a href={t.repo}>Code on GitHub</a></p>
            </header>

            <div class="project-body has-measures">
              <div class="prose">
                {t.body.map((para) => <p>{para}</p>)}
                <p class="stack">Built with {t.stack.join(', ')}.</p>
              </div>
              <div class="measures">
                {t.measures.map((m) => <Measure measure={m} />)}
              </div>
            </div>

            <details class="how">
              <summary>See how {t.name} works</summary>
              <Diagram kind={t.diagram} />
            </details>
          </article>
        ))}
      </section>

      <section id="research" class="section wrap" aria-labelledby="research-h">
        <h2 id="research-h" class="section-title">Peer-reviewed research</h2>
        <ol class="rows">
          {publications.map((pub) => (
            <li class="row">
              <p class="row-side">{pub.venue}</p>
              <div class="row-main">
                <h3>{pub.title}</h3>
                <p>{pub.finding}</p>
                {pub.repo && <p class="row-link"><a href={pub.repo}>Code</a></p>}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="experience" class="section wrap" aria-labelledby="exp-h">
        <div class="split">
          <div>
            <h2 id="exp-h" class="section-title">Experience</h2>
            <ol class="rows rows-tight">
              {roles.map((r) => (
                <li class="row">
                  <p class="row-side">{r.period}{r.place && <><br />{r.place}</>}</p>
                  <div class="row-main">
                    <h3>{r.org}</h3>
                    <p>{r.title}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <div>
            <h2 class="section-title">Education</h2>
            <ol class="rows rows-tight">
              {schools.map((s) => (
                <li class="row">
                  <p class="row-side">{s.period}</p>
                  <div class="row-main">
                    <h3>{s.name}</h3>
                    <p>{s.degree}{s.note && <><br />{s.note}</>}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer wrap">
      <p class="footer-cta">
        Hiring for 2027? Write to <a href={`mailto:${profile.email}`}>{profile.email}</a>.
      </p>
      <p class="footer-meta">
        <a href="https://github.com/patsypppe">GitHub</a>
        <a href="https://www.linkedin.com/in/pranavpattanashetty">LinkedIn</a>
        <a href="https://github.com/patsypppe/patsypppe.github.io">Source for this site</a>
        <span>Static Astro and TypeScript, no client-side JavaScript.</span>
      </p>
    </footer>
  </body>
</html>
